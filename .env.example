# Server-only YouTube Data API v3 key (never expose to the client).
# Either name is accepted; YOUTUBE_API_KEY takes precedence.
YOUTUBE_API_KEY=
GOOGLE_API_KEY=

# Backend connection (managed automatically in Lovable Cloud)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Code execution sandbox (optional overrides).
# Defaults to the public Judge0 CE instance; point this at a self-hosted
# Judge0 cluster for production-grade isolation and higher throughput.
JUDGE0_URL=https://ce.judge0.com
# JUDGE0_AUTH_TOKEN=
# JUDGE0_RAPIDAPI_KEY=
